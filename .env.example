# PostgreSQL local. Thay DB_PASSWORD bang mat khau PostgreSQL tren may.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mekong_mobile_l2
DB_USER=postgres
DB_PASSWORD=thay_bang_mat_khau_postgres

# Tuy chon: neu co DATABASE_URL thi no duoc uu tien hon cac DB_* o tren.
DATABASE_URL=

# API_PORT duoc uu tien; PORT la ten thay the neu khong khai bao API_PORT.
API_PORT=3001
PORT=3001

# Vite dev server. De trong VITE_API_BASE_URL de goi API qua proxy /api.
VITE_PORT=5173
VITE_API_BASE_URL=
