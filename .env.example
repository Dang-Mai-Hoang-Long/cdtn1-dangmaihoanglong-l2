# TỆP CẤU HÌNH MẪU
# Sao chép tệp này thành .env ở thư mục gốc dự án trước khi chạy.
# Các giá trị bên dưới chỉ là giá trị mẫu. Không điền mật khẩu thật vào .env.example,
# không commit .env và không dùng mật khẩu demo khi triển khai cho người dùng thật.

# KẾT NỐI POSTGRESQL
# Chạy ứng dụng trực tiếp trên máy: DB_HOST/DB_PORT là địa chỉ PostgreSQL trên máy;
# DB_PASSWORD phải được thay bằng mật khẩu của tài khoản DB_USER.
# Chạy bằng Docker Compose: không cần PostgreSQL cài trên máy. Compose tự dùng hostname
# nội bộ "database" và cổng 5432 trong mạng Docker; các biến DB_* bên dưới cấu hình
# tên database, tài khoản và mật khẩu dùng chung giữa container PostgreSQL và ứng dụng.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mekong_mobile_l2
DB_USER=postgres
DB_PASSWORD=thay_bang_mat_khau_postgres

# Tùy chọn: chỉ cần dùng DATABASE_URL nếu muốn thay nhóm DB_* bằng một chuỗi kết nối.
# Khi chạy trực tiếp trên máy, bỏ dấu # và thay tên người dùng, mật khẩu, máy chủ, cổng
# cùng tên database bằng thông tin PostgreSQL của bạn. DATABASE_URL được ưu tiên hơn DB_*.
# Ví dụ: postgresql://postgres:<mat_khau_postgres>@localhost:5432/mekong_mobile_l2
# Thay mật khẩu mẫu bằng mật khẩu PostgreSQL nếu muốn dùng chuỗi kết nối này.
# Nếu mật khẩu có ký tự đặc biệt, hãy mã hóa URL các ký tự đó. Docker Compose không chuyển
# DATABASE_URL vào container; trong Docker hãy cấu hình DB_* như phần trên.
DATABASE_URL= # postgresql://postgres:<mat_khau_postgres>@localhost:5432/mekong_mobile_l2

# CỔNG DỊCH VỤ
# API_PORT là cổng backend Express; mặc định 3001. PORT chỉ là biến dự phòng nếu không
# đặt API_PORT. Nếu cổng bị chiếm, dừng dịch vụ đang dùng cổng đó hoặc đổi API_PORT.
# Khi đổi cổng API lúc chạy local, Vite sẽ dùng cùng API_PORT làm đích proxy.
API_PORT=3001
PORT=3001

# VITE_PORT là cổng giao diện phát triển Vite; mặc định 5173.
# Để VITE_API_BASE_URL trống để frontend gọi backend qua proxy /api của Vite.
# Địa chỉ API tùy chọn; để trống để dùng proxy /api của Vite.
VITE_PORT=5173
VITE_API_BASE_URL= # http://localhost:3001

# COOKIE PHIÊN ĐĂNG NHẬP
# Đặt false khi chạy HTTP trên máy local. Đặt true khi ứng dụng được phục vụ qua HTTPS;
# cookie đăng nhập khi đó chỉ được gửi qua kết nối HTTPS.
AUTH_COOKIE_SECURE=false

# TÀI KHOẢN TÙY CHỌN
# Chỉ dùng nếu muốn tạo thêm một tài khoản; nếu không, giữ các dòng ví dụ bên dưới ở dạng
# comment. Năm tài khoản demo được tạo tự động khi khởi động ứng dụng.
# Các biến này KHÔNG tự tạo tài khoản khi container khởi động. Để tạo tài khoản tùy chọn,
# điền các trường phù hợp rồi chạy: npm run auth:create-user
# Trong Docker, chạy lệnh: docker compose exec app node scripts/createUser.js
# APP_USER_USERNAME: tên đăng nhập, từ 1 đến 80 ký tự.
# APP_USER_PASSWORD: mật khẩu từ 12 đến 200 ký tự; không dùng mật khẩu demo.
# APP_USER_ROLE: NHAN_VIEN_TIEP_NHAN hoặc QUAN_LY.
# Nếu là NHAN_VIEN_TIEP_NHAN, đặt APP_USER_CENTER_ID: 0 = Trung tâm A, 1 = Trung tâm B;
# để APP_USER_CENTER_IDS trống.
# Nếu là QUAN_LY, để APP_USER_CENTER_ID trống và đặt APP_USER_CENTER_IDS là danh sách
# mã trung tâm cách nhau bằng dấu phẩy, ví dụ: 0,1.
# Dòng mẫu bên dưới cấu hình nhân viên ở Trung tâm A. Tự đặt tên và mật khẩu riêng nếu dùng.
APP_USER_USERNAME= # nhanvien.tuychon
APP_USER_PASSWORD= # mat_khau_rieng_toi_thieu_12_ky_tu
APP_USER_ROLE= # NHAN_VIEN_TIEP_NHAN
APP_USER_CENTER_ID= # 0 (Trung tâm A) hoặc 1 (Trung tâm B)
APP_USER_CENTER_IDS= # Chỉ dành cho QUAN_LY, ví dụ: 0,1

# KIỂM THỬ TÍCH HỢP TRỰC TIẾP TRÊN MÁY
# Khi chạy npm test trực tiếp trên máy và muốn chạy các test PostgreSQL, hãy tạo trước một
# database kiểm thử riêng. Bỏ dấu # ở dòng mẫu, thay mật khẩu bằng mật khẩu PostgreSQL,
# rồi thay host/cổng nếu PostgreSQL không chạy mặc định trên máy này.
# Tên database phải kết thúc bằng _test; ví dụ dưới đây dùng DB_NAME_test.
# Các test sẽ xóa và dựng lại schema bên trong database này. Tuyệt đối không dùng tên
# database ứng dụng (mekong_mobile_l2) vì dữ liệu trong database được chọn sẽ bị xóa.
# Ví dụ dùng DB_NAME mặc định; thay <mat_khau_postgres> bằng mật khẩu PostgreSQL của bạn.
TEST_DATABASE_URL= postgresql://<ten_nguoi_dung>:<mat_khau_postgres>@<may_chu>:<cong>/<ten_database>_test
